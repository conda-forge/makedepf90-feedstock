 {
     char *rule;
-    int i, j, k, rlen, slen;
+    int i, j, k, rlen, slen, npct;
 
-    rule = (char *)xmalloc(RULE_LENGTH*sizeof(char));
     rlen = strlen(r);
 
     /* set slen = length of srcfile without suffix */
